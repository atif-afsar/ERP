# ==============================================================================
# EduNexus ERP - Frontend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and configure for your deployment environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VPS Native Backend API Base URL
# ------------------------------------------------------------------------------
# In production on Vercel, configure this with your deployed VPS backend domain:
# VITE_API_URL=https://YOUR-BACKEND-DOMAIN.com/api
#
# In local development:
VITE_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# 2. AI Intelligence (Gemini Integration)
# ------------------------------------------------------------------------------
# Google Gemini AI API key for natural language assistance and document intelligence
VITE_GEMINI_API_KEY=your-gemini-api-key-here
