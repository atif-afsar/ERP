# ==============================================================================
# EduNexus ERP - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your credentials.
# NEVER commit the real .env file with production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend Connection (Browser-Safe Public Credentials)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Public Anonymous API Key (safe to use in browser)
# NEVER put your secret 'service_role' key here!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Toggle live database querying: 'true' enables live Supabase calls, 'false' stays in resilient offline mode
VITE_ENABLE_LIVE_DB=true

# ------------------------------------------------------------------------------
# 2. AI Intelligence (Gemini Integration)
# ------------------------------------------------------------------------------
# Google Gemini AI API key for natural language assistance and document intelligence
VITE_GEMINI_API_KEY=your-gemini-api-key-here
