PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/edunexus_erp
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=7d
JWT_ISSUER=edunexus-api
JWT_AUDIENCE=edunexus-web
FRONTEND_URL=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
CORS_ORIGIN=http://127.0.0.1:5173
LOG_LEVEL=debug

# LOG never sends externally. Production requires LIVE.
EMAIL_DELIVERY_MODE=LOG
EMAIL_PROVIDER=RESEND
EMAIL_FROM_NAME=EduNexus
EMAIL_FROM_ADDRESS=notifications@example.invalid
RESEND_API_KEY=
NOTIFICATION_POLL_MS=5000
