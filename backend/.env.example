# ==============================================================================
# EduNexus ERP - Backend Environment Configuration (.env.example)
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection URL (Target your local or VPS PostgreSQL instance)
DATABASE_URL=postgresql://edunexus_user:YOUR_STRONG_DB_PASSWORD@127.0.0.1:5432/edunexus_erp

# JWT Authentication Secrets (Must be min 32-character secure random string in production)
JWT_SECRET=generate_a_secure_random_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for CORS (e.g. Your Vercel frontend URL)
FRONTEND_URL=https://your-edunexus-erp.vercel.app

# Optional CORS wildcard or comma-separated origins (leave blank if using FRONTEND_URL)
CORS_ORIGIN=

# Logging level (debug | info | warn | error)
LOG_LEVEL=info
