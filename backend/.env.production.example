# =====================================================================
# EduNexus ERP — Production Backend Environment Configuration Example
# Copy to .env on your production VPS: cp .env.production.example .env
# ALL VALUES BELOW ARE SANITIZED PLACEHOLDERS — PROVIDE REAL SECRETS ON VPS
# =====================================================================

PORT=5000
NODE_ENV=production

# 1. Database Configuration
# Connects to the local PostgreSQL 16 cluster via Unix domain socket or loopback
DATABASE_URL=postgresql://edunexus_user:REPLACE_WITH_STRONG_GENERATED_DB_PASSWORD@127.0.0.1:5432/edunexus_erp

# 2. Authentication Secrets (Must be at least 32 characters, cryptographically random)
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_A_REAL_CRYPTOGRAPHIC_JWT_SECRET_32_CHARS_MIN
JWT_EXPIRES_IN=7d
JWT_ISSUER=edunexus-api
JWT_AUDIENCE=edunexus-web

# 3. Application & CORS URLs (Must use HTTPS in production)
FRONTEND_URL=https://erp.edunexus.example.com
APP_PUBLIC_URL=https://erp.edunexus.example.com
CORS_ORIGIN=https://erp.edunexus.example.com

# 4. Logging & Diagnostics
LOG_LEVEL=info

# 5. Outbound Email Delivery (Strictly enforced in production by backend/src/config.ts)
# Production requires EMAIL_DELIVERY_MODE=LIVE with verified sender and Resend API key
EMAIL_DELIVERY_MODE=LIVE
EMAIL_PROVIDER=RESEND
EMAIL_FROM_NAME=EduNexus ERP Notifications
EMAIL_FROM_ADDRESS=notifications@your-verified-institution-domain.com
RESEND_API_KEY=re_REPLACE_WITH_YOUR_ACTUAL_RESEND_API_KEY
NOTIFICATION_POLL_MS=5000
